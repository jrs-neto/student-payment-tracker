# Servidor
PORT=3000

# PostgreSQL: use DATABASE_URL ou as variáveis DB_* abaixo.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=usuario_local
DB_PASSWORD=
DB_NAME=student_payment_tracker
DB_SSL=false

# Segredo privado usado para assinar JWT (mínimo de 32 caracteres).
JWT_SECRET=

# Necessário somente para o fluxo de reivindicação da conta legada.
LEGACY_CLAIM_SECRET=

# Google Identity Services: mesmo client ID configurado no frontend.
GOOGLE_CLIENT_ID=

# Necessária somente se o assistente Gemini estiver habilitado.
GEMINI_API_KEY=

# Origens do frontend autorizadas pelo CORS, separadas por vírgula.
FRONTEND_URL=http://localhost:5173

# Conta pública de demonstração; mantenha false se não for oferecida.
DEMO_ENABLED=false
DEMO_ACCOUNT_EMAIL=
# Usadas somente pelo provisionador no backend; nunca no frontend.
DEMO_ACCOUNT_PASSWORD=
DEMO_PROVISION_CONFIRM=
