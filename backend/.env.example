# Servidor
PORT=3000

# PostgreSQL - configuração local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_NAME=sistema_mensalidades
DB_SSL=false

# PostgreSQL - conexão Neon ou outro banco remoto
# Preencha DATABASE_URL quando utilizar uma conexão por URL.
DATABASE_URL=

# Google Gemini API
GEMINI_API_KEY=

# Frontend - origens autorizadas pelo CORS
FRONTEND_URL=http://localhost:5173